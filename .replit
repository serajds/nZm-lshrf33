modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[[ports]]
localPort = 4173
externalPort = 5173

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 18082
externalPort = 4200

[[ports]]
localPort = 18115
externalPort = 3001

[[ports]]
localPort = 22349
externalPort = 3000

[[ports]]
localPort = 22350
externalPort = 3002

[deployment]
deploymentTarget = "autoscale"
build = ["pnpm", "run", "build"]

[userenv]

[userenv.shared]
OPENAI_API_BASE = "https://api.groq.com/openai/v1"

[userenv.development]
IMAGE_AUDIT_BUCKET_ID = "replit-objstore-425422f6-cee2-461f-8331-c7f5746fd92d"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[objectStorage]
defaultBucketID = "replit-objstore-e2a8d32d-ff8d-4db4-8adf-cea8f1ff447b"

[workflows]
runButton = "Project"
