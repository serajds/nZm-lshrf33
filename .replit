modules = ["nodejs-24"]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18115
externalPort = 3001

[[ports]]
localPort = 22349
externalPort = 3000

[[ports]]
localPort = 22350
externalPort = 3002

[deployment]
deploymentTarget = "autoscale"
build = ["pnpm", "run", "build"]

[userenv]

[userenv.shared]
OPENAI_API_BASE = "https://api.groq.com/openai/v1"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
