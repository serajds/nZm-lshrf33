{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present --filter=!@workspace/mobile run build",
    "test:session-cache": "node --test --experimental-strip-types tests/*.test.mjs",
    "test:activity-sources": "node --test --experimental-strip-types tests/activity-source-rules.test.mjs",
    "test:deviation": "node --test tests/deviation-analysis.test.mjs",
    "test:deviation:http": "NODE_ENV=development DEVIATION_HTTP_TESTS=1 LOG_LEVEL=silent node --import ./scripts/node_modules/tsx/dist/loader.mjs --test tests/deviation-http.integration.test.mjs",
    "test:network-lifecycle": "node --test --experimental-strip-types tests/network-lifecycle.test.mjs",
    "test:performance:http": "NODE_ENV=development PERFORMANCE_HTTP_TESTS=1 LOG_LEVEL=silent node --import ./scripts/node_modules/tsx/dist/loader.mjs --test tests/performance-http.integration.test.mjs",
    "test:excel-import:http": "NODE_ENV=development EXCEL_IMPORT_HTTP_TESTS=1 LOG_LEVEL=silent node --import ./scripts/node_modules/tsx/dist/loader.mjs --test tests/excel-import-http.integration.test.mjs",
    "test:session-cache:browser": "node --test tests/browser-session-cache.test.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --filter \"!@workspace/mockup-sandbox\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
