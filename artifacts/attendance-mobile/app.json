{
  "expo": {
    "name": "ركاز - RIKAZ",
    "slug": "attendance-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "attendance-mobile",
    "supportsRTL": true,
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/rikaz-lockup.png",
      "imageWidth": 180,
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.constructionsupervision.attendance",
      "infoPlist": {
        "CFBundleLocalizations": ["ar"]
      }
    },
    "android": {
      "package": "com.constructionsupervision.attendance",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#17354B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "ركاز - RIKAZ",
      "shortName": "ركاز",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "نستخدم الكاميرا الأمامية لالتقاط صورة مرافقة لتسجيل الحضور أو الانصراف.",
          "photosPermission": "لاستخدام صورة مرافقة لتسجيل الحضور أو الانصراف.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك أثناء تسجيل الحضور أو الانصراف للتحقق من موقع المشروع."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
